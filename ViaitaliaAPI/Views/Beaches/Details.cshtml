@model ViaitaliaAPI.Models.Beach
@{
    ViewData["Title"] = Model.BeachName;
    Layout = null;
    bool isWriter = User.IsInRole("Writer");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.BeachName - Viaitalia</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
</head>
<body>

@await Html.PartialAsync("_Header")

<div class="detail-wrap">
    <p class="detail-breadcrumb"><a asp-controller="Beaches" asp-action="Index">Beaches</a> / @Model.BeachName</p>

    <div class="detail-hero">
        @if (Model.Image != null)
        {
            <img src="@Model.Image.FilePath" alt="@Model.BeachName"
                 onerror="this.onerror=null;this.src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';this.style.background='var(--color-border)';" />
        }
        <div class="detail-hero__overlay">
            <div>
                <h1 class="detail-hero__title">@Model.BeachName</h1>
                <p class="detail-hero__subtitle">@Model.CityName</p>
            </div>
        </div>
    </div>

    <div class="fact-grid">
        <div class="fact-item"><div class="fact-item__label">Type</div><div class="fact-item__value">@(Model.BeachType ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Water Body</div><div class="fact-item__value">@(Model.WaterBodyName ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Blue Flag</div><div class="fact-item__value">@(Model.BlueFlag ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Accessibility</div><div class="fact-item__value">@(Model.Accessibility ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Best Months</div><div class="fact-item__value">@(Model.BestMonths ?? "N/A")</div></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <h3>About</h3>
        <p>@Model.Description</p>
    }
    @if (!string.IsNullOrEmpty(Model.Facilities))
    {
        <h3>Facilities</h3>
        <p>@Model.Facilities</p>
    }

    @if (isWriter)
    {
        <div class="writer-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline btn-sm">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">Delete</a>
        </div>
    }
</div>

@await Html.PartialAsync("_Footer")

</body>
</html>