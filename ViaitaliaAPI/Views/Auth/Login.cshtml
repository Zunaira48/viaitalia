@{
    Layout = null;
}
@model ViaitaliaAPI.Models.DTO.LoginRequestDto
@{
    ViewData["Title"] = "User Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --color-white: #ffffff;
            --color-primary: #076750;
            --color-dark: #032026;
            --color-border-light: #88d2d3;
            --color-border-medium: #7dd0b6;
            --color-placeholder: rgba(255, 255, 255, 0.58);
            --bg-card: rgba(17, 87, 79, 0.42);
            --bg-gradient: linear-gradient(135deg, #022c38 0%, #0a4336 100%);
            --neon-color: #00ffff;
            --neon-purple: #9d00ff;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Karma', serif;
            background: var(--bg-gradient);
            color: var(--color-white);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-attachment: fixed;
            background-size: cover;
        }
        a {
            color: inherit;
            text-decoration: none;
        }
        input, button {
            font-family: inherit;
            border: none;
            background: none;
            color: inherit;
        }
        .page-container {
            width: 100%;
            max-width: 1440px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 60px;
            padding-right: 60px;
        }
        @@media (max-width: 768px) {
            .page-container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        /* Header Styles */
        .site-header {
            padding-top: 24px;
            padding-bottom: 24px;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .home-link {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .home-icon {
            width: 48px;
            height: 48px;
        }
        .home-text {
            font-family: 'Jaldi', sans-serif;
            font-weight: 400;
            font-size: 32px;
            line-height: 1.69;
        }
        .signup-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 16px 24px;
            min-width: 156px;
            height: 60px;
            background-color: var(--color-primary);
            border-radius: 50px;
            font-family: 'Karma', serif;
            font-weight: 700;
            font-size: 24px;
            line-height: 1.63;
            text-align: center;
            transition: background-color 0.3s ease;
        }
        .signup-button:hover {
            opacity: 0.9;
        }
        @@media (max-width: 480px) {
            .home-text {
                font-size: 24px;
            }
            .home-icon {
                width: 36px;
                height: 36px;
            }
            .signup-button {
                font-size: 18px;
                padding: 12px 20px;
                min-width: auto;
                height: auto;
            }
        }
        /* Login Section Styles */
        .login-section {
            flex-grow: 1;
            display: flex;
            align-items: flex-start; /* Changed from center to flex-start */
            justify-content: center;
            padding: 30px 20px 20px; /* Increased top padding, reduced bottom */
            margin-top: 20px; /* Added margin to move form up */
        }
        
        /* Neon Form Effect */
        .login-card {
            width: 100%;
            max-width: 480px; /* Reduced from 567px */
            padding: 35px 35px 45px; /* Increased padding for more height */
            background-color: var(--bg-card);
            border: 1px solid var(--color-border-medium);
            border-radius: 50px;
            box-shadow: 0px 2px 6px 6px rgba(173, 229, 221, 0.15), 0px 1px 2px 0px rgba(3, 3, 3, 0.3);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            transition: all 0.3s ease;
        }
        
        /* Neon glow effect for the form */
        .login-card:hover {
            border-color: var(--neon-color);
            box-shadow: 
                0 0 5px var(--neon-color),
                0 0 10px var(--neon-color),
                0 0 15px var(--neon-color),
                0 0 20px var(--neon-color),
                0 0 25px var(--neon-color),
                0 0 30px var(--neon-color),
                inset 0 0 15px rgba(0, 255, 255, 0.1);
        }
        
        /* Add a subtle pulsing animation */
        @@keyframes neon-pulse {
            0% {
                box-shadow: 
                    0 0 5px var(--neon-color),
                    0 0 10px var(--neon-color),
                    0 0 15px var(--neon-color),
                    0 0 20px var(--neon-color),
                    0 0 25px var(--neon-color),
                    0 0 30px var(--neon-color),
                    inset 0 0 15px rgba(0, 255, 255, 0.1);
            }
            50% {
                box-shadow: 
                    0 0 8px var(--neon-color),
                    0 0 15px var(--neon-color),
                    0 0 20px var(--neon-color),
                    0 0 25px var(--neon-color),
                    0 0 30px var(--neon-color),
                    0 0 35px var(--neon-color),
                    inset 0 0 20px rgba(0, 255, 255, 0.2);
            }
            100% {
                box-shadow: 
                    0 0 5px var(--neon-color),
                    0 0 10px var(--neon-color),
                    0 0 15px var(--neon-color),
                    0 0 20px var(--neon-color),
                    0 0 25px var(--neon-color),
                    0 0 30px var(--neon-color),
                    inset 0 0 15px rgba(0, 255, 255, 0.1);
            }
        }
        
        .login-card:hover {
            animation: neon-pulse 2s infinite;
        }
        
        .login-title {
            font-family: 'Jura', sans-serif;
            font-weight: 700;
            font-size: 40px;
            line-height: 1.18;
            text-align: center;
            margin-bottom: 35px; /* Increased from 30px */
            text-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
        }
        
        .login-form {
            width: 100%;
            display: flex;
            flex-direction: column;
        }
        
        /* Fixed Input Fields - No blocks, text appears directly in field */
        .input-group {
            width: 100%;
            height: 50px;
            border: 1px solid var(--color-border-light);
            border-radius: 50px;
            display: flex;
            align-items: center;
            padding: 0 25px;
            margin-bottom: 20px;
            background: transparent;
            position: relative;
            transition: all 0.3s ease;
        }
        
        /* Neon effect for input fields on focus */
        .input-group:focus-within {
            border-color: var(--neon-color);
            box-shadow: 
                0 0 5px var(--neon-color),
                0 0 10px var(--neon-color),
                inset 0 0 5px rgba(0, 255, 255, 0.1);
            background: transparent;
        }
        
        /* Input field styling */
        .form-input {
            width: 100%;
            font-family: 'Karma', serif;
            font-weight: 700;
            font-size: 18px;
            line-height: 1.63;
            background: transparent;
            border: none;
            outline: none;
            padding: 0;
            margin: 0;
            color: var(--color-white);
            position: relative;
            z-index: 2;
        }
        
        /* Placeholder styling */
        .form-input::placeholder {
            color: var(--color-placeholder);
            opacity: 1;
        }
        
        /* Remove default input focus styles */
        .form-input:focus {
            outline: none;
            box-shadow: none;
            background: transparent;
        }
        
        /* Remove Webkit autofill background */
        .form-input:-webkit-autofill,
        .form-input:-webkit-autofill:hover,
        .form-input:-webkit-autofill:focus,
        .form-input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 30px var(--bg-card) inset !important;
            -webkit-text-fill-color: var(--color-white) !important;
            transition: background-color 5000s ease-in-out 0s;
        }
        
        /* Hide validation message to prevent visual disruption */
        .input-group .text-danger {
            position: absolute;
            bottom: -18px;
            left: 25px;
            font-size: 12px;
        }
        
        .forgot-password-link {
            font-family: 'Karma', serif;
            font-weight: 700;
            font-size: 20px;
            line-height: 1.63;
            margin-top: -5px;
            margin-bottom: 35px; /* Increased from 30px */
            align-self: flex-start;
            transition: all 0.3s ease;
        }
        
        .forgot-password-link:hover {
            color: var(--neon-color);
            text-shadow: 0 0 5px var(--neon-color);
        }
        
        /* Neon Button Effect */
        .login-button {
            width: 160px;
            height: 55px;
            background-color: var(--color-dark);
            border-radius: 15px;
            font-family: 'Karma', serif;
            font-weight: 700;
            font-size: 28px;
            line-height: 1.63;
            text-align: center;
            cursor: pointer;
            align-self: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }
        
        /* Neon Glow Effect on Hover */
        .login-button:hover {
            color: var(--color-white);
            box-shadow: 
                0 0 5px var(--neon-color),
                0 0 10px var(--neon-color),
                0 0 15px var(--neon-color),
                0 0 20px var(--neon-color),
                0 0 35px var(--neon-color),
                0 0 40px var(--neon-color);
            text-shadow: 
                0 0 5px var(--neon-color),
                0 0 10px var(--neon-color);
        }
        
        /* Additional animation for the button */
        .login-button:before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }
        
        .login-button:hover:before {
            left: 100%;
        }
        
        /* Success message styling */
        .alert-success {
            background-color: rgba(0, 255, 0, 0.1);
            border: 1px solid rgba(0, 255, 0, 0.3);
            color: var(--color-white);
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 15px;
            width: 100%;
            text-align: center;
            font-size: 16px;
        }
        
        @@media (max-width: 768px) {
            .login-card {
                padding: 30px 25px 35px; /* Adjusted for mobile */
                max-width: 90%; /* Increased width for mobile */
            }
            .login-title {
                font-size: 32px;
                margin-bottom: 30px;
            }
            .form-input {
                font-size: 16px;
            }
            .forgot-password-link {
                font-size: 18px;
                margin-bottom: 30px;
            }
            .login-button {
                width: 140px;
                height: 50px;
                font-size: 22px;
            }
        }
    </style>
</head>
<body>
    <header id="header" class="site-header">
        <div class="page-container header-container">
            <a asp-controller="Home" asp-action="Index" class="home-link">
                <img src="~/images/home-agreement.png" alt="Home Icon" class="home-icon" />
                <span class="home-text">Home</span>
            </a>

            <a asp-action="Register" asp-controller="Auth" class="signup-button">Sign up</a>
        </div>
    </header>

    <main id="login" class="login-section">
        <div class="login-card">
            <h1 class="login-title">Log In</h1>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            
            <form asp-action="Login" asp-controller="Auth" method="post" class="login-form">
                <div asp-validation-summary="All" class="text-danger"></div>
                
                <div class="input-group">
                    <input asp-for="UserName" type="email" placeholder="Enter your email address" class="form-input" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                
                <div class="input-group">
                    <input asp-for="Password" type="password" placeholder="Enter Password" class="form-input" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                
                <a asp-action="ForgotPassword" asp-controller="Auth" class="forgot-password-link">Forget password</a>
                
                <button type="submit" class="login-button">Log in</button>
            </form>
        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>