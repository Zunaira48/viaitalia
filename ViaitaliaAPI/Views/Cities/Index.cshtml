@model IEnumerable<ViaitaliaAPI.Models.City>
@{
    ViewData["Title"] = "Cities";
    Layout = null; // This disables the layout page
    bool isWriter = User.IsInRole("Writer");
    bool isReader = User.IsInRole("Reader");
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var requestToken = tokens.RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ViaItalia</title>
    <style>
        :root {
            --color-primary: #7acbcd;
            --color-secondary: #0ae7bb;
            --color-dark: #001a33;
            --color-text: #000000;
            --color-white: #ffffff;
            --card-bg: rgba(81, 152, 158, 0.66);
            --font-main: 'Inter', sans-serif;
            --font-display: 'Palatino Linotype', 'Georgia', serif;
            --font-nav: 'Karma', sans-serif;
        }
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        body {
            font-family: var(--font-main);
            background-color: var(--color-white);
            color: var(--color-text);
            line-height: 1.6;
        }
        
        .page-wrapper {
            max-width: 1440px;
            margin: 0 auto;
            overflow: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        h1, h2, h3, p {
            margin: 0;
        }
        
        /* Header Styles */
        .site-header {
            padding: 15px 0;
        }
        
        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
        }
        
        .site-header .logo img {
            width: 232px;
            height: 89px;
            display: block;
        }
        
        .main-nav {
            position: relative;
            margin-bottom: 23px;
        }
        
        .main-nav ul {
            display: flex;
            align-items: center;
            gap: 19px;
        }
        
        .main-nav a {
            font-family: var(--font-nav);
            font-size: 26px;
            font-weight: 400;
            padding: 10px 15px;
            position: relative;
            white-space: nowrap;
        }
        
        .main-nav a.active {
            font-weight: 700;
        }
        
        .main-nav a.active::after {
            content: '';
            position: absolute;
            bottom: -23px;
            left: 50%;
            transform: translateX(-50%);
            width: 98px;
            height: 14px;
            background-color: var(--color-primary);
            border-radius: 3px;
        }
        
        .main-nav::before {
            content: '';
            position: absolute;
            bottom: -23px;
            left: 0;
            right: 0;
            height: 1px;
            background-color: rgba(0, 0, 0, 0.55);
        }
        
        .signout-btn {
            background-color: var(--color-secondary);
            color: var(--color-white);
            font-family: var(--font-nav);
            font-size: 24px;
            font-weight: 400;
            padding: 5px 25px;
            border-radius: 50px;
            line-height: 35px;
            white-space: nowrap;
            display: inline-block;
        }
        .signout-btn:hover{
            background-color: darkcyan;
        }
        /* Hero Section Styles */
        .hero-section {
            padding: 32px 0 88px;
        }
        
        .hero-container {
            padding: 0 121px;
        }
        
        .hero-title {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 64px;
            line-height: 1.35;
            margin-bottom: 32px;
        }
        
        .hero-subtitle {
            font-family: var(--font-display);
            font-weight: 400;
            font-size: 40px;
            line-height: 1.35;
            max-width: 995px;
        }
        
        /* Create Button Styles */
        .create-section {
            padding: 0 30px 20px;
            text-align: right;
        }
        
        .create-btn {
            background-color: var(--color-secondary);
            color: var(--color-white);
            font-family: var(--font-nav);
            font-size: 20px;
            font-weight: 400;
            padding: 8px 20px;
            border-radius: 50px;
            display: inline-block;
            margin-bottom: 20px;
        }
        
        /* Cities Section Styles */
        .cities-section {
            padding: 0 30px 116px;
        }
        
        .cities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 70px 18px;
        }
        
        .city-card {
            background-color: var(--card-bg);
            border-radius: 59px;
            padding: 20px 17px;
            transition: transform 0.3s ease;
        }
        
        .city-card:hover {
            transform: translateY(-5px);
        }
        
        .city-card__image {
            width: 100%;
            height: 275px;
            object-fit: cover;
            border-radius: 42px;
            display: block;
        }
        
        .city-card__content {
            padding: 21px 0 20px 21px;
        }
        
        .city-card__title {
            font-family: var(--font-main);
            font-weight: 700;
            font-size: 32px;
            line-height: 1.2;
            margin-bottom: 10px;
        }
        
        .city-card__title a {
            color: var(--color-text);
        }
        
        .city-card__title a:hover {
            text-decoration: underline;
        }
        
        .city-card__region {
            font-family: var(--font-main);
            font-weight: 400;
            font-size: 24px;
            line-height: 1.2;
            margin-bottom: 15px;
            color: var(--color-dark);
        }
        
        .city-card__info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        
        .city-card__info-item {
            font-family: var(--font-main);
            font-weight: 400;
            font-size: 18px;
            line-height: 1.2;
        }
        
        .city-card__info-label {
            font-weight: 700;
            margin-right: 5px;
        }
        
        .city-card__actions {
            margin-top: 15px;
            display: flex;
            gap: 10px;
        }
        
        .city-card__actions a {
            font-family: var(--font-main);
            font-size: 16px;
            padding: 5px 12px;
            border-radius: 5px;
            display: inline-block;
        }
        
        .btn-edit {
            background-color: #ffc107;
            color: #212529;
        }
        
        .btn-details {
            background-color: #17a2b8;
            color: white;
        }
        
        .btn-delete {
            background-color: #dc3545;
            color: white;
        }
        
        /* Footer Styles - Full Width */
        .site-footer {
            background-color: var(--color-dark);
            width: 100%;
            margin-top: 0;
        }
        
        .footer-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 1440px;
            margin: 0 auto;
            padding: 28px 40px;
        }
        
        .site-footer .logo img {
            width: 182px;
            height: 69px;
            display: block;
        }
        
        .footer-nav ul {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px 43px;
        }
        
        .footer-nav a {
            color: var(--color-white);
            font-family: var(--font-nav);
            font-size: 24px;
            font-weight: 400;
        }
        
        /* Responsive Tablet */
        @@media (max-width: 1024px) {
            .header-container,
            .hero-container,
            .cities-section {
                padding-left: 20px;
                padding-right: 20px;
            }
            .main-nav {
                display: none;
            }
            .main-nav::before {
                display: none;
            }
            /* Adjust footer for tablet */
            .footer-container {
                padding: 28px 20px;
            }
        }
        
        /* Responsive Mobile */
        @@media (max-width: 767px) {
            .header-container {
                padding: 15px 20px;
            }
            .hero-container {
                padding-top: 40px;
                padding-bottom: 40px;
            }
            .hero-title {
                font-size: 48px;
            }
            .hero-subtitle {
                font-size: 24px;
            }
            .cities-grid {
                grid-template-columns: 1fr;
                row-gap: 40px;
            }
            .footer-container {
                flex-direction: column;
                gap: 30px;
                padding: 40px 20px;
            }
            
            .footer-nav ul {
                flex-direction: column;
                align-items: center;
                gap: 20px;
            }
            
            .city-card__actions {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <!-- Header Section -->
        <header class="site-header">
            <div class="header-container">
                <a href="#" class="logo">
                    <img src="~/images/ViaItalia teal + blue combo logo.png" alt="ViaItalia Logo">
                </a>
                 <nav class="main-nav">
    <ul>
        <li><a asp-controller="AttractionPlaces" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AttractionPlaces" ? "active" : "")">Attractions</a></li>
        <li><a asp-controller="Hotels" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Hotels" ? "active" : "")">Hotels</a></li>
        <li><a asp-controller="Beaches" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Beaches" ? "active" : "")">Beaches</a></li>
        <li><a asp-controller="Cities" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cities" ? "active" : "")">Cities</a></li>
        <li><a asp-controller="ShoppingMalls" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ShoppingMalls" ? "active" : "")">Shopping Malls</a></li>
        <li><a asp-controller="Restaurants" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Restaurants" ? "active" : "")">Restaurants</a></li>
    </ul>
</nav>

                <form asp-action="Logout" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="signout-btn">Sign out</button>
                </form>
            </div>
        </header>

        <!-- Hero Section -->
        <section class="hero-section">
            <div class="hero-container">
                <h1 class="hero-title">Cities</h1>
                <p class="hero-subtitle">Here we suggest you some popular cities of Italy.</p>
            </div>
        </section>

        <!-- Create Button Section (only for Writer users) -->
        @if (isWriter)
        {
            <div class="create-section">
                <a asp-action="Create" class="create-btn">Create New</a>
            </div>
        }

        <!-- Cities Section -->
        <section id="cities" class="cities-section">
            <div class="cities-grid">
                @foreach (var item in Model)
                {
                    <article class="city-card">
                        <!-- Using a placeholder image with city name as seed -->
                        @if (@item.Image != null)
                        {
                            <img src="@item.Image.FilePath" class="city-card__image" alt="@item.CityName, @item.Region" />
                        }
                        <div class="city-card__content">
                            <h3 class="city-card__title">
                                <a asp-action="Details" asp-route-id="@item.CityId">@item.CityName</a>
                            </h3>
                            <p class="city-card__region">@item.Region</p>
                            
                            <div class="city-card__info">
                                <div class="city-card__info-item">
                                    <span class="city-card__info-label">Population:</span>
                                    <span>@(item.Population?.ToString("N0") ?? "N/A")</span>
                                </div>
                                <div class="city-card__info-item">
                                    <span class="city-card__info-label">Area:</span>
                                    <span>@(item.AreaKm2?.ToString() + " km²" ?? "N/A")</span>
                                </div>
                            </div>
                            
                            <div class="city-card__info">
                                <div class="city-card__info-item">
                                    <span class="city-card__info-label">Region Code:</span>
                                    <span>@item.RegionCode</span>
                                </div>
                                <div class="city-card__info-item">
                                    <span class="city-card__info-label">City Code:</span>
                                    <span>@item.CityCode</span>
                                </div>
                            </div>
                            
                            <div class="city-card__actions">
                                @if (isWriter)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.CityId" class="btn-edit">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.CityId" class="btn-details">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.CityId" class="btn-delete">Delete</a>
                                }
                                else if (isReader)
                                {
                                    <a asp-action="Details" asp-route-id="@item.CityId" class="btn-details">Details</a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    </div>

    <!-- Footer Section - Full Width -->
    <footer class="site-footer">
        <div class="footer-container">
            <a href="#" class="logo">
                <img src="~/images/ViaItalia logo in white.png" alt="ViaItalia Logo">
            </a>
            <nav class="footer-nav">
                <ul>
                    <li><a asp-controller="Pages" asp-action="Contactus">Contact us</a></li>
                    <li><a asp-controller="Pages" asp-action="Aboutus">About us</a></li>
                    <li><a asp-controller="Pages" asp-action="Terms">Term&condition</a></li>
                    <li><a asp-controller="Pages" asp-action="PrivacyPolicy">Privacy policy</a></li>
                    <li><a asp-controller="Pages" asp-action="Blog">Blog</a></li>
                </ul>
            </nav>
        </div>
    </footer>
</body>
@await Html.PartialAsync("_Header") 

</html>