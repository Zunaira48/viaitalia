@model ViaitaliaAPI.Models.City
@{
    ViewData["Title"] = Model.CityName;
    Layout = null;
    bool isWriter = User.IsInRole("Writer");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.CityName - Viaitalia</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
</head>
<body>

@await Html.PartialAsync("_Header")

<div class="detail-wrap">
    <p class="detail-breadcrumb"><a asp-controller="Cities" asp-action="Index">Cities</a> / @Model.CityName</p>

    <div class="detail-hero">
        @if (Model.Image != null)
        {
            <img src="@Model.Image.FilePath" alt="@Model.CityName"
                 onerror="this.onerror=null;this.src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';this.style.background='var(--color-border)';" />
        }
        <div class="detail-hero__overlay">
            <div>
                <h1 class="detail-hero__title">@Model.CityName</h1>
                <p class="detail-hero__subtitle">@Model.Region@(string.IsNullOrEmpty(Model.ProvinceName) ? "" : $", {Model.ProvinceName}")</p>
            </div>
        </div>
    </div>

    <div class="fact-grid">
        <div class="fact-item"><div class="fact-item__label">Population</div><div class="fact-item__value">@(Model.Population?.ToString("N0") ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Area</div><div class="fact-item__value">@(Model.AreaKm2?.ToString() + " km²" ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Region Code</div><div class="fact-item__value">@Model.RegionCode</div></div>
        <div class="fact-item"><div class="fact-item__label">Nearest Airport</div><div class="fact-item__value">@(Model.NearestAirportName ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Official Language</div><div class="fact-item__value">@(Model.OfficialLanguage ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Currency</div><div class="fact-item__value">@(Model.Currency ?? "N/A")</div></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <h3>About @Model.CityName</h3>
        <p>@Model.Description</p>
    }

    @if (isWriter)
    {
        <div class="writer-actions">
            <a asp-action="Edit" asp-route-id="@Model.CityId" class="btn btn-outline btn-sm">Edit</a>
            <form asp-action="Delete" asp-route-id="@Model.CityId" method="get" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
        </div>
    }
</div>

@await Html.PartialAsync("_Footer")

</body>
</html>