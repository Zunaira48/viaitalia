@model ViaitaliaAPI.Models.City
<a class="discovery-card" asp-controller="Cities" asp-action="Details" asp-route-id="@Model.CityId">
    @if (Model.Image != null)
    {
        <img class="discovery-card__image" src="@Model.Image.FilePath" alt="@Model.CityName" />
    }
    else
    {
        <div class="discovery-card__image"></div>
    }
    <p class="discovery-card__title">@Model.CityName</p>
    <p class="discovery-card__meta">@Model.Region</p>
</a>