@model ViaitaliaAPI.Models.Restaurant
@{
    ViewData["Title"] = Model.RestaurantName;
    Layout = null;
    bool isWriter = User.IsInRole("Writer");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.RestaurantName - Viaitalia</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
</head>
<body>

@await Html.PartialAsync("_Header")

<div class="detail-wrap">
    <p class="detail-breadcrumb"><a asp-controller="Restaurants" asp-action="Index">Restaurants</a> / @Model.RestaurantName</p>

    <div class="detail-hero">
        @if (Model.Image != null)
        {
            <img src="@Model.Image.FilePath" alt="@Model.RestaurantName"
                 onerror="this.onerror=null;this.src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';this.style.background='var(--color-border)';" />
        }
        <div class="detail-hero__overlay">
            <div>
                <h1 class="detail-hero__title">@Model.RestaurantName</h1>
                <p class="detail-hero__subtitle">@Model.CityName</p>
            </div>
        </div>
    </div>

    <div class="fact-grid">
        <div class="fact-item"><div class="fact-item__label">Cuisine</div><div class="fact-item__value">@(Model.CuisineType ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Category</div><div class="fact-item__value">@(Model.Category ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Hours</div><div class="fact-item__value">@Model.OpeningTime - @Model.ClosingTime</div></div>
        <div class="fact-item"><div class="fact-item__label">Address</div><div class="fact-item__value">@(Model.StreetAddress ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Phone</div><div class="fact-item__value">@(Model.PhoneNumber ?? "N/A")</div></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <h3>About</h3>
        <p>@Model.Description</p>
    }

    @if (isWriter)
    {
        <div class="writer-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline btn-sm">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">Delete</a>
        </div>
    }
</div>

@await Html.PartialAsync("_Footer")

</body>
</html>