<link rel="stylesheet" href="~/css/design-system.css" />

<header class="site-header">
    <a href="/" class="logo">
        <img src="~/images/ViaItalia teal + blue combo logo.png" alt="Viaitalia" />
    </a>

    <nav class="nav-links">
        <a asp-controller="Cities" asp-action="Index">Cities</a>
        <a asp-controller="Hotels" asp-action="Index">Hotels</a>
        <a asp-controller="Restaurants" asp-action="Index">Restaurants</a>
        <a asp-controller="Beaches" asp-action="Index">Beaches</a>
        <a asp-controller="ShoppingMalls" asp-action="Index">Shopping</a>
        <a asp-controller="AttractionPlaces" asp-action="Index">Attractions</a>
        <a asp-controller="TravelPlanner" asp-action="Plan">Planner</a>
    </nav>

    <div class="nav-user">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <span style="font-size: var(--fs-sm); color: var(--color-text-muted);">Hi, @User.Identity.Name</span>
            @if (!User.IsInRole("Writer"))
            {
                <a asp-controller="Auth" asp-action="RequestWriterAccess" class="btn btn-outline btn-sm">Request Writer Access</a>
            }
            <form asp-action="Logout" asp-controller="Auth" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary btn-sm">Log out</button>
            </form>
        }
        else
        {
            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline btn-sm">Log in</a>
            <a asp-controller="Auth" asp-action="Register" class="btn btn-primary btn-sm">Sign up</a>
        }
    </div>
</header>