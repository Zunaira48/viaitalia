                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Cities" ? "active" : "")" asp-controller="Cities" asp-action="Index">Cities</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Beaches" ? "active" : "")" asp-controller="Beaches" asp-action="Index">Beaches</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "AttractionPlaces" ? "active" : "")" asp-controller="AttractionPlaces" asp-action="Index">Attractions</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Hotels" ? "active" : "")" asp-controller="Hotels" asp-action="Index">Hotels</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Restaurants" ? "active" : "")" asp-controller="Restaurants" asp-action="Index">Restaurants</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "ShoppingMalls" ? "active" : "")" asp-controller="ShoppingMalls" asp-action="Index">Shopping Malls</a>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
