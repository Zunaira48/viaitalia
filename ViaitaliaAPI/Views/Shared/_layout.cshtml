                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentAction == "Login" ? "active" : "")" asp-controller="Auth" asp-action="Login">Login</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentAction == "Register" ? "active" : "")" asp-controller="Auth" asp-action="Register">Register</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        }*@
    </header>
    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="text-center text-muted mt-4 mb-2">
        <hr />
        &copy; @DateTime.Now.Year - Viaitalia
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
