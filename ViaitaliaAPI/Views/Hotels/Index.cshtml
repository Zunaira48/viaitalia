@model List<ViaitaliaAPI.Models.Hotel>
@{
    ViewData["Title"] = "Hotels";
    Layout = null;
    bool isWriter = User.IsInRole("Writer");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hotels - Viaitalia</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
</head>
<body>

@await Html.PartialAsync("_Header")

<section class="section-wrap" style="padding-top: var(--space-xl);">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:var(--space-md);">
        <div>
            <span class="section-eyebrow">Explore</span>
            <h1 style="margin-bottom:0;">Hotels</h1>
        </div>
        @if (isWriter)
        {
            <a asp-action="Create" class="btn btn-primary">Create new</a>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="discovery-grid" id="results-grid" style="margin-top: var(--space-lg);">
            @foreach (var hotel in Model)
            {
                @await Html.PartialAsync("_HotelCardItem", hotel)
            }
        </div>

        <div style="text-align:center; margin-top: var(--space-xl);">
            <p id="results-count" style="color:var(--color-text-muted); font-size:var(--fs-sm);">
                Showing @ViewBag.Loaded of @ViewBag.TotalCount
            </p>
            @if ((int)ViewBag.Loaded < (int)ViewBag.TotalCount)
            {
                <button id="load-more-btn" class="btn btn-outline" data-skip="@ViewBag.Loaded" data-pagesize="@ViewBag.PageSize">
                    Load more
                </button>
            }
        </div>
    }
    else
    {
        <div class="state-message">
            <h3>No hotels found</h3>
            <p>Check back soon.</p>
        </div>
    }
</section>

@await Html.PartialAsync("_Footer")

<script>
document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('load-more-btn');
    if (!btn) return;
    btn.addEventListener('click', async function () {
        var skip = parseInt(btn.dataset.skip, 10);
        var pageSize = parseInt(btn.dataset.pagesize, 10);
        btn.textContent = 'Loading...';
        const response = await fetch('/Hotels/LoadMore?skip=' + skip);
        const html = await response.text();
        document.getElementById('results-grid').insertAdjacentHTML('beforeend', html);
        btn.dataset.skip = skip + pageSize;
        var loadedCount = document.querySelectorAll('#results-grid .discovery-card').length;
        var totalCount = @ViewBag.TotalCount;
        document.getElementById('results-count').textContent = 'Showing ' + loadedCount + ' of ' + totalCount;
        if (loadedCount >= totalCount) { btn.remove(); } else { btn.textContent = 'Load more'; }
    });
});
</script>

</body>
</html>