@model ViaitaliaAPI.Models.Hotel
@{
    ViewData["Title"] = Model.HotelName;
    Layout = null;
    bool isWriter = User.IsInRole("Writer");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.HotelName - Viaitalia</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
</head>
<body>

@await Html.PartialAsync("_Header")

<div class="detail-wrap">
    <p class="detail-breadcrumb"><a asp-controller="Hotels" asp-action="Index">Hotels</a> / @Model.HotelName</p>

    <div class="detail-hero">
        @if (Model.Image != null)
        {
            <img src="@Model.Image.FilePath" alt="@Model.HotelName"
                 onerror="this.onerror=null;this.src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';this.style.background='var(--color-border)';" />
        }
        <div class="detail-hero__overlay">
            <div>
                <h1 class="detail-hero__title">@Model.HotelName</h1>
                <p class="detail-hero__subtitle">@Model.CityName</p>
            </div>
        </div>
    </div>

    <div class="fact-grid">
        <div class="fact-item"><div class="fact-item__label">Stars</div><div class="fact-item__value">@(Model.Stars ?? 0)★</div></div>
        <div class="fact-item"><div class="fact-item__label">Budget</div><div class="fact-item__value">@(Model.Budget ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Address</div><div class="fact-item__value">@(Model.Address ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Phone</div><div class="fact-item__value">@(Model.PhoneNumber ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Opening Hours</div><div class="fact-item__value">@(Model.OpeningHours ?? "N/A")</div></div>
        @if (!string.IsNullOrEmpty(Model.Website))
        {
            <div class="fact-item"><div class="fact-item__label">Website</div><div class="fact-item__value"><a href="@Model.Website" target="_blank" style="color:var(--color-primary);">Visit site</a></div></div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Amenities))
    {
        <h3>Amenities</h3>
        <p>@Model.Amenities</p>
    }

    @if (isWriter)
    {
        <div class="writer-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline btn-sm">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">Delete</a>
        </div>
    }
</div>

@await Html.PartialAsync("_Footer")

</body>
</html>