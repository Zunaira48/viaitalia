@model ViaitaliaAPI.Models.Hotel
@{
    ViewData["Title"] = "Hotel Details";
    Layout = null;  // This removes any layout page
    var source = Context.Request.Query["source"].ToString();
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var requestToken = tokens.RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - ViaItalia</title>
    <style>
        :root {
            --color-primary: #7acbcd;
            --color-secondary: #0ae7bb;
            --color-text-dark: #010f28;
            --color-text-light: #ffffff;
            --color-text-body: #000000;
            --color-text-muted: #00514c;
            --color-bg-light: #ffffff;
            --color-bg-dark: #001a33;
            --color-card-bg: rgba(122, 165, 181, 0.72);
            --font-family-main: 'Karma', serif;
        }
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        body {
            font-family: var(--font-family-main);
            background-color: var(--color-bg-light);
            color: var(--color-text-body);
            overflow-x: hidden;
        }
        
        .page-wrapper {
            max-width: 1440px;
            margin: 0 auto;
            background-color: var(--color-bg-light);
        }
        
        .container {
            width: 100%;
            padding: 0 80px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .section-title-wrapper {
            margin-bottom: 24px;
        }
        
        .section-title {
            color: var(--color-text-dark);
            font-size: 40px;
            font-weight: 700;
            margin-bottom: 0;
        }
        
        .title-underline {
            width: 122px;
            height: 8px;
            background: linear-gradient(90deg, #44849c 0%, #408687 100%);
            border-radius: 5px;
            margin-top: 8px;
        }
        
       /* Header Styles */
        .site-header {
            padding: 15px 0;
        }
        
        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
        }
        
        .site-header .logo img {
            width: 232px;
            height: 89px;
            display: block;
        }
        
        .main-nav {
            position: relative;
            margin-bottom: 23px;
        }
        
        .main-nav ul {
            display: flex;
            align-items: center;
            gap: 19px;
        }
        
        .main-nav a {
            font-family: var(--font-nav);
            font-size: 26px;
            font-weight: 400;
            padding: 10px 15px;
            position: relative;
            white-space: nowrap;
        }
        
        .main-nav a.active {
            font-weight: 700;
        }
        
        .main-nav a.active::after {
            content: '';
            position: absolute;
            bottom: -23px;
            left: 50%;
            transform: translateX(-50%);
            width: 98px;
            height: 14px;
            background-color: var(--color-primary);
            border-radius: 3px;
        }
        
        .main-nav::before {
            content: '';
            position: absolute;
            bottom: -23px;
            left: 0;
            right: 0;
            height: 1px;
            background-color: rgba(0, 0, 0, 0.55);
        }
        
        .signout-btn {
            background-color: var(--color-secondary);
            color: var(--color-white);
            font-family: white;
            font-size: 24px;
            font-weight: 400;
            padding: 5px 25px;
            border-radius: 50px;
            line-height: 35px;
            white-space: nowrap;
            display: inline-block;
        }
        .signout-btn:hover{
            background-color: darkcyan;
        }
        
        /* Hero Section Styles */
        .hero-section {
            text-align: center;
        }
        
        .page-title-container {
            padding-top: 46px;
            padding-bottom: 91px;
        }
        
        .page-title {
            font-size: 64px;
            font-weight: 700;
            color: var(--color-text-body);
            margin-bottom: 24px;
        }
        
        .page-subtitle {
            font-size: 36px;
            font-weight: 500;
            color: var(--color-text-muted);
        }
        
        .hero-banner {
            position: relative;
            width: 100%;
            height: 959px;
        }
        
        .hero-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 0px 0px 40px 40px;
        }
        
        .hero-text-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: var(--color-text-light);
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
        }
        
        .hero-title {
            font-size: 64px;
            font-weight: 700;
            line-height: 1.2;
        }
        
        .hero-location {
            font-size: 64px;
            font-weight: 700;
            line-height: 1.2;
        }
        
        /* Star Rating */
        .star-rating {
            display: inline-flex;
            align-items: center;
            margin-top: 1rem;
        }
        
        .star-rating i {
            color: #ffc107;
            font-size: 1.5rem;
            margin-right: 0.25rem;
        }
        
        /* Main Content Styles */
        .main-content {
            padding-top: 110px;
            padding-bottom: 100px;
        }
        
        .content-section {
            margin-bottom: 80px;
        }
        
        .description-card {
            background-color: var(--color-card-bg);
            border-radius: 0px 30px 0px 30px;
            padding: 22px 30px;
            font-size: 24px;
            text-align: center;
            line-height: 1.45;
        }
        
        .location-card {
            background-color: var(--color-card-bg);
            border-radius: 0px 30px 0px 30px;
            padding: 30px 50px;
        }
        
        .location-header {
            color: #012932;
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 20px;
        }
        
        .location-grid {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 10px 30px;
            font-size: 36px;
        }
        
        .location-label {
            color: #1b7d88;
            font-weight: 700;
            text-align: right;
        }
        
        .location-value {
            font-weight: 400;
        }
        
        .characteristics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            background-color: var(--color-card-bg);
            border-radius: 0px 30px 0px 30px;
            padding: 20px;
        }
        
        .char-card {
            background-color: rgba(72, 152, 158, 0.41);
            border-radius: 40px 0px 40px 0px;
            padding: 16px;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 94px;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .char-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            background-color: rgba(72, 152, 158, 0.6);
        }
        
        .char-label {
            color: #467d75;
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 4px;
        }
        
        .char-value {
            color: var(--color-text-body);
            font-size: 20px;
            font-weight: 600;
        }
        
        .beach-details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            background-color: var(--color-card-bg);
            border-radius: 0px 30px 0px 30px;
            padding: 20px;
        }
        
        .details-card {
            background-color: rgba(72, 152, 158, 0.41);
            border-radius: 40px 0px 40px 0px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .details-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            background-color: rgba(72, 152, 158, 0.6);
        }
        
        .details-label {
            display: block;
            color: #467d75;
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 10px;
        }
        
        .details-value {
            display: block;
            color: var(--color-text-body);
            font-size: 32px;
            font-weight: 500;
        }
        
        .info-card {
            background-color: var(--color-card-bg);
            border-radius: 0px 30px 0px 30px;
            padding: 34px;
            font-size: 40px;
            font-weight: 400;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            background-color: rgba(122, 165, 181, 0.9);
        }
        
        .tag-container {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            background-color: var(--color-card-bg);
            border-radius: 0px 30px 0px 30px;
            padding: 20px;
        }
        
        .tag-badge {
            background-color: rgba(72, 152, 158, 0.41);
            border-radius: 40px 0px 40px 0px;
            padding: 15px 25px;
            font-size: 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .tag-badge:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            background-color: rgba(72, 152, 158, 0.8);
        }
        
        .website-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #7acbcd, #0ae7bb);
            color: white;
            padding: 15px 30px;
            border-radius: 50px;
            font-size: 28px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
            margin: 0 auto;
        }
        
        .website-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(13, 110, 253, 0.4);
        }
        
        .website-btn i {
            margin-left: 10px;
        }
        
        .back-button-wrapper {
            text-align: center;
            margin-top: 80px;
            display: flex;
            justify-content: center;
            gap: 20px;
        }
        
        .btn-back {
            display: inline-block;
            background-color: rgba(72, 152, 158, 0.64);
            border: 2px solid #01181d;
            border-radius: 40px 0px 40px 0px;
            padding: 15px 50px;
            font-size: 32px;
            font-weight: 600;
            color: var(--color-text-body);
            transition: all 0.3s ease;
        }
        
        .btn-back:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            background-color: rgba(72, 152, 158, 0.9);
        }
        
        .btn-edit {
            display: inline-block;
            background-color: var(--color-secondary);
            border: 2px solid #01181d;
            border-radius: 40px 0px 40px 0px;
            padding: 15px 50px;
            font-size: 32px;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
        }
        
        .btn-edit:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            background-color: rgba(10, 231, 187, 0.9);
        }
        
        /* Footer Styles */
        .site-footer {
            background-color: var(--color-bg-dark);
            color: var(--color-text-light);
            padding: 30px 0;
        }
        
        .footer-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }
        
        .footer-logo img {
            height: 45px;
            width: auto;
        }
        
        .footer-nav ul {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px 40px;
        }
        
        .footer-nav a {
            font-size: 24px;
        }
        
        /* Responsive Styles */
        @@media (max-width: 1024px) {
            .container {
                padding: 0 40px;
            }
            
            .hero-banner {
                height: 600px;
            }
            
            .main-nav {
                display: none;
            }
            
            .footer-container {
                flex-direction: column;
                justify-content: center;
                gap: 30px;
            }
        }
        
        @@media (max-width: 768px) {
            .container {
                padding: 0 20px;
            }
            
            .section-title {
                font-size: 32px;
            }
            
            .header-container {
                flex-direction: column;
                gap: 20px;
            }
            
            .logo img {
                height: 40px;
            }
            
            .btn-signin {
                font-size: 20px;
            }
            
            .page-title-container {
                padding-top: 30px;
                padding-bottom: 50px;
            }
            
            .page-title {
                font-size: 48px;
            }
            
            .page-subtitle {
                font-size: 24px;
            }
            
            .hero-banner {
                height: 400px;
            }
            
            .hero-title, .hero-location {
                font-size: 40px;
            }
            
            .main-content {
                padding-top: 60px;
            }
            
            .content-section {
                margin-bottom: 40px;
            }
            
            .description-card, .location-grid, .details-label, .details-value, .tag-badge, .btn-back, .btn-edit {
                font-size: 18px;
            }
            
            .location-header {
                font-size: 24px;
            }
            
            .location-card {
                padding: 20px;
            }
            
            .beach-details-grid {
                grid-template-columns: 1fr;
            }
            
            .info-card {
                font-size: 24px;
                padding: 20px;
            }
            
            .website-btn {
                font-size: 20px;
                padding: 12px 20px;
            }
            
            .tag-container {
                flex-direction: column;
                gap: 10px;
            }
            
            .footer-nav a {
                font-size: 18px;
            }
            
            .back-button-wrapper {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="site-header">
      <div class="container header-container">
        <a href="#" class="logo">
          <img src="~/images/ViaItalia teal + blue combo logo.png" alt="ViaItalia logo">
        </a>
         <nav class="main-nav">
    <ul>
        <li><a asp-controller="AttractionPlaces" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AttractionPlaces" ? "active" : "")">Attractions</a></li>
        <li><a asp-controller="Hotels" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Hotels" ? "active" : "")">Hotels</a></li>
        <li><a asp-controller="Beaches" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Beaches" ? "active" : "")">Beaches</a></li>
        <li><a asp-controller="Cities" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cities" ? "active" : "")">Cities</a></li>
        <li><a asp-controller="ShoppingMalls" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ShoppingMalls" ? "active" : "")">Shopping Malls</a></li>
        <li><a asp-controller="Restaurants" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Restaurants" ? "active" : "")">Restaurants</a></li>
    </ul>
</nav>
            <form asp-action="Logout" asp-controller="Auth" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="signout-btn">Sign out</button>
            </form>
      </div>
    </header>
    <!-- Hero Section -->
    <section id="hero" class="hero-section">
      <div class="container page-title-container">
        <h1 class="page-title">Hotel Details</h1>
        <p class="page-subtitle">Discover the finest accommodations in Italy</p>
      </div>
      <div class="hero-banner">
        @if (Model.ImageId != null && Model.Image != null && !string.IsNullOrEmpty(Model.Image.FilePath))
        {
            <img src="@Model.Image.FilePath" alt="@Model.HotelName" class="hero-image">
        }
        else
        {
            <img src="/page/f31b5b64-b5fb-4bba-8ef6-fea65269bb6c/images/7a454be6e1ef434732bea7b1cc7d0cb0da2ecf43.png" alt="Hotel" class="hero-image">
        }
        <div class="hero-text-overlay">
          <h2 class="hero-title">@Model.HotelName</h2>
          <p class="hero-location">@Model.City?.CityName</p>
          <div class="star-rating">
            @for (int i = 1; i <= 5; i++)
            {
                if (i <= Model.Stars)
                {
                    <i class="bi bi-star-fill"></i>
                }
                else
                {
                    <i class="bi bi-star"></i>
                }
            }
          </div>
        </div>
      </div>
    </section>
    <!-- Main Content -->
    <main id="details" class="main-content">
      <div class="container">
        <!-- Location Info Section -->
        <section id="location" class="content-section">
          <div class="section-title-wrapper">
            <h2 class="section-title">Location Info</h2>
            <div class="title-underline"></div>
          </div>
          <div class="location-card">
            <div class="location-header">@Model.HotelName</div>
            <div class="location-grid">
              <div class="location-label">City:</div>
              <div class="location-value">@Model.City?.CityName</div>
              <div class="location-label">Address:</div>
              <div class="location-value">@Model.Address</div>
              <div class="location-label">Postal Code:</div>
              <div class="location-value">@Model.PostalCode</div>
              <div class="location-label">Latitude:</div>
              <div class="location-value">@Model.Latitude</div>
              <div class="location-label">Longitude:</div>
              <div class="location-value">@Model.Longitude</div>
            </div>
          </div>
        </section>
        
        <!-- Hotel Details Section -->
        <section id="hotel-details" class="content-section">
          <div class="section-title-wrapper">
            <h2 class="section-title">Hotel Details</h2>
            <div class="title-underline"></div>
          </div>
          <div class="characteristics-grid">
            <div class="char-card">
              <span class="char-label">Stars</span>
              <span class="char-value">@Model.Stars</span>
            </div>
            <div class="char-card">
              <span class="char-label">Phone Number</span>
              <span class="char-value">@Model.PhoneNumber</span>
            </div>
            <div class="char-card">
              <span class="char-label">Opening Hours</span>
              <span class="char-value">@Model.OpeningHours</span>
            </div>
            <div class="char-card">
              <span class="char-label">Budget</span>
              <span class="char-value">@Model.Budget</span>
            </div>
          </div>
        </section>
        
        <!-- Contact Information Section -->
        <section id="contact" class="content-section">
          <div class="section-title-wrapper">
            <h2 class="section-title">Contact Information</h2>
            <div class="title-underline"></div>
          </div>
          <div class="beach-details-grid">
            <div class="details-card">
              <span class="details-label">Website</span>
              <span class="details-value">@Model.Website</span>
            </div>
            <div class="details-card">
              <span class="details-label">Phone</span>
              <span class="details-value">@Model.PhoneNumber</span>
            </div>
          </div>
        </section>
        
        <!-- Amenities Section -->
        <section id="amenities" class="content-section">
          <div class="section-title-wrapper">
            <h2 class="section-title">Amenities</h2>
            <div class="title-underline"></div>
          </div>
          <div class="info-card">
            <p>@Model.Amenities</p>
          </div>
        </section>
        
        <!-- Official Website Section -->
        <section id="website" class="content-section">
          <div class="section-title-wrapper">
            <h2 class="section-title">Official Website</h2>
            <div class="title-underline"></div>
          </div>
          <div class="section-card">
            <a href="@Model.Website" target="_blank" class="website-btn">
              Visit Site <i class="bi bi-box-arrow-up-right"></i>
            </a>
          </div>
        </section>
        
        <!-- Back Button -->
        <div class="back-button-wrapper">
            @if (User.IsInRole("Writer"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-edit">Edit</a>
            }
            @if (source == "planner")
            {
                <a asp-controller="TravelPlanner" asp-action="PlanResult" class="btn-back">Back to Planner</a>
            }
            else
            {
                <a asp-action="Index" class="btn-back">Back to List</a>
            }
        </div>
      </div>
    </main>
    <!-- Footer -->
    <footer class="site-footer">
      <div class="container footer-container">
        <a href="#" class="footer-logo">
          <img src="~/images/ViaItalia logo in white.png" alt="ViaItalia white logo">
        </a>
        <nav class="footer-nav">
          <ul>
            <li><a href="#">Contact us</a></li>
            <li><a href="#">About us</a></li>
            <li><a href="#">Term&condition</a></li>
            <li><a href="#">Privacy policy</a></li>
            <li><a href="#">Blog</a></li>
          </ul>
        </nav>
      </div>
    </footer>
</body>
</html>