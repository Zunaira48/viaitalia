@model ViaitaliaAPI.Models.ShoppingMall
@{
    ViewData["Title"] = Model.MallName;
    Layout = null;
    bool isWriter = User.IsInRole("Writer");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.MallName - Viaitalia</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
</head>
<body>

@await Html.PartialAsync("_Header")

<div class="detail-wrap">
    <p class="detail-breadcrumb"><a asp-controller="ShoppingMalls" asp-action="Index">Shopping</a> / @Model.MallName</p>

    <div class="detail-hero">
        @if (Model.Image != null)
        {
            <img src="@Model.Image.FilePath" alt="@Model.MallName"
                 onerror="this.onerror=null;this.src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';this.style.background='var(--color-border)';" />
        }
        <div class="detail-hero__overlay">
            <div>
                <h1 class="detail-hero__title">@Model.MallName</h1>
                <p class="detail-hero__subtitle">@Model.CityName</p>
            </div>
        </div>
    </div>

    <div class="fact-grid">
        <div class="fact-item"><div class="fact-item__label">Rating</div><div class="fact-item__value">@(Model.Rating.HasValue ? $"{Model.Rating}★" : "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Total Shops</div><div class="fact-item__value">@(Model.TotalShops?.ToString() ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Opening Hours</div><div class="fact-item__value">@(Model.OpeningHours ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Affordability</div><div class="fact-item__value">@(Model.Affordability ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Parking</div><div class="fact-item__value">@(Model.ParkingCapacity?.ToString() ?? "N/A")</div></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <h3>About</h3>
        <p>@Model.Description</p>
    }
    @if (!string.IsNullOrEmpty(Model.PopularBrands))
    {
        <h3>Popular Brands</h3>
        <p>@Model.PopularBrands</p>
    }

    @if (isWriter)
    {
        <div class="writer-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline btn-sm">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">Delete</a>
        </div>
    }
</div>

@await Html.PartialAsync("_Footer")

</body>
</html>