@model ViaitaliaAPI.Models.ShoppingMall

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this Shopping Mall?</h3>
<div>
    <h4>Shopping Mall Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.City.CityName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.City.CityName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MallName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MallName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Location)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Location)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Region)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Region)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TotalShops)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TotalShops)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AreaSqFt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AreaSqFt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ParkingCapacity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ParkingCapacity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OpeningHours)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OpeningHours)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Rating)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Rating)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Facilities)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Facilities)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PopularBrands)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PopularBrands)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.YearEstablished)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.YearEstablished)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Affordability)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Affordability)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>

        @if (Model.ImageId != null && Model.Image != null && !string.IsNullOrEmpty(Model.Image.FilePath))
        {
            <div class="mt-3">
                <label>Current Image</label>
                <img src="@Model.Image.FilePath" alt="Shopping Mall Image" class="img-thumbnail" width="250" />
            </div>
        }
        else
        {
            <dt class="col-sm-2">Image</dt>
            <dd class="col-sm-10">Not Assigned</dd>
        }
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>





