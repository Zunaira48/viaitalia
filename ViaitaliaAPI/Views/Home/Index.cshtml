@model IEnumerable<ViaitaliaAPI.Models.City>
@{
    ViewData["Title"] = "Viaitalia - Home";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Viaitalia — Discover Italy</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
</head>
<body>

@await Html.PartialAsync("_Header")

<section class="hero-editorial" style="background-image: url('/images/Cool-Italy-Background.jpg');">
    <div class="hero-editorial-content">
        <span class="hero-eyebrow">Your trip planner for Italy</span>
        <h1>Discover Italy, one city at a time</h1>
        <p>Curated hotels, restaurants and experiences across 39 cities.</p>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a class="btn btn-primary" asp-controller="TravelPlanner" asp-action="Plan">Start planning</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Auth" asp-action="Login">Start planning</a>
        }
    </div>
</section>

<nav class="quick-links">
    <a asp-controller="Cities" asp-action="Index">Cities</a>
    <a asp-controller="Hotels" asp-action="Index">Hotels</a>
    <a asp-controller="Restaurants" asp-action="Index">Restaurants</a>
    <a asp-controller="Beaches" asp-action="Index">Beaches</a>
    <a asp-controller="ShoppingMalls" asp-action="Index">Shopping</a>
    <a asp-controller="AttractionPlaces" asp-action="Index">Attractions</a>
</nav>

<section class="section-wrap">
    <span class="section-eyebrow">Popular cities</span>
    <h2>Explore Italy</h2>

    @if (Model != null && Model.Any())
    {
        <div class="discovery-grid">
            @foreach (var city in Model)
            {
                <a class="discovery-card" asp-controller="Cities" asp-action="Details" asp-route-id="@city.CityId">
                    @if (city.Image != null)
                    {
                        <img class="discovery-card__image" src="@city.Image.FilePath" alt="@city.CityName" />
                    }
                    else
                    {
                        <div class="discovery-card__image"></div>
                    }
                    <p class="discovery-card__title">@city.CityName</p>
                    <p class="discovery-card__meta">@city.Region</p>
                </a>
            }
        </div>
        <div style="text-align:center; margin-top: var(--space-xl);">
            <a asp-controller="Cities" asp-action="Index" class="btn btn-outline">View all cities</a>
        </div>
    }
    else
    {
        <div class="state-message">
            <h3>No cities to show yet</h3>
            <p>Check back soon.</p>
        </div>
    }
</section>

@await Html.PartialAsync("_Footer")

</body>
</html>