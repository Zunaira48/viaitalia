@model ViaitaliaAPI.Models.TravelPlannerRequest
@{
    ViewData["Title"] = "Plan Your Trip";
    Layout = null; // Remove or change depending on whether this is a full page or partial
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var requestToken = tokens.RequestToken;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/recommendation form.css?v=1" />
   
</head>
<body>
<header class="site-header">
    <div class="container header-container">
        <a href="#" class="logo">
            <img src="~/images/ViaItalia teal + blue combo logo.png" alt="ViaItalia logo">
        </a>
        <nav class="main-nav">
    <ul>
        <li><a asp-controller="AttractionPlaces" asp-action="Index" class="nav-btn">Attractions</a></li>
        <li><a asp-controller="Hotels" asp-action="Index" class="nav-btn">Hotels</a></li>
        <li><a asp-controller="Beaches" asp-action="Index" class="nav-btn">Beaches</a></li>
        <li><a asp-controller="Cities" asp-action="Index" class="nav-btn">Cities</a></li>
        <li><a asp-controller="ShoppingMalls" asp-action="Index" class="nav-btn">Shopping malls</a></li>
        <li><a asp-controller="Restaurants" asp-action="Index" class="nav-btn">Restaurants</a></li>
    </ul>
</nav>
            <form asp-action="Logout" asp-controller="Auth" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="signout-btn">Sign out</button>
            </form>
    </div>
</header>
<main id="main-content">
    <div class="container">
        <form asp-action="Plan" method="post" class="trip-form">
            <!-- Trip Preferences Intro -->
            <div class="form-intro">
                <h1 class="form-main-title">Provide us your Trip preferences</h1>
                <p class="form-subtitle">
                    Give some Specific information about your Trip, Our Travel Planner will Generate a customized Plan according to your Preferences.
                </p>
            </div>
            <!-- Companion Selection -->
            <section id="companions" class="form-section">
                <h2 class="section-title">With whom you plan to Travel?</h2>
                <div class="form-group block-options">
                    <div class="block-option">
                        <input type="radio" asp-for="GroupType" value="Friends" id="group-Friends" />
                        <label for="group-Friends">
                            <img src="~/images/followers.png" alt="Friends icon">
                            Friends
                        </label>
                    </div>
                    <div class="block-option">
                        <input type="radio" asp-for="GroupType" value="Couple" id="group-Couple" />
                        <label for="group-Couple">
                            <img src="~/images/couple.png" alt="Couple icon">
                            Couple
                        </label>
                    </div>
                    <div class="block-option">
                        <input type="radio" asp-for="GroupType" value="Family" id="group-Family" />
                        <label for="group-Family">
                            <img src="~/images/family.png" alt="Family icon">
                            Family
                        </label>
                    </div>
                    <span asp-validation-for="GroupType" class="text-danger"></span>
                </div>
            </section>
            <!-- Trip Duration -->
            <section id="duration" class="form-section">
                <h2 class="section-title">How many days do you plan to travel?</h2>
                <div class="form-group">
                    <div class="duration-container">
                        <div class="duration-label">Days</div>
                        <div class="duration-controls">
                            <button type="button" class="decrease" id="decreaseBtn">−</button>
                            <input asp-for="TripDuration" class="form-control" id="durationInput" type="number" min="1" value="5" />
                            <button type="button" class="increase" id="increaseBtn">+</button>
                        </div>
                    </div>
                    <span asp-validation-for="TripDuration" class="text-danger"></span>
                </div>
            </section>
            <!-- Wheelchair Accessibility -->
            <section id="accessibility" class="form-section">
                <h2 class="section-title">Require Wheelchair</h2>
                <div class="form-group radio-large">
                    <div class="radio-option">
                        <input type="radio" asp-for="RequiresWheelchair" value="true" id="wheelchair-yes" />
                        <label for="wheelchair-yes">Yes</label>
                    </div>
                    <div class="radio-option">
                        <input type="radio" asp-for="RequiresWheelchair" value="false" id="wheelchair-no" />
                        <label for="wheelchair-no">No</label>
                    </div>
                    <span asp-validation-for="RequiresWheelchair" class="text-danger"></span>
                </div>
            </section>
            <!-- Preferred Destination Theme (MultiSelect Razor) -->
            <section id="theme" class="form-section">
                <h2 class="section-title">Preferred destination Theme</h2>
                <div class="form-group">
                    <select asp-for="SelectedTags" asp-items="@(new MultiSelectList(Model.AvailableTags))" multiple class="form-control theme-select" size="8">
                    </select>
                    <span asp-validation-for="SelectedTags" class="text-danger"></span>
                </div>
            </section>
            <!-- Arrival Airport (Razor Loop) -->
            <section id="airport" class="form-section">
                <h2 class="section-title">Arrival Airport</h2>
                <div class="form-group">
                    <select asp-for="SelectedAirport" class="form-control airport-select">
                        <option value="">-- Select Airport --</option>
                        @foreach (var airport in Model.AvailableAirports)
                        {
                            <option value="@airport">@airport</option>
                        }
                    </select>
                    <span asp-validation-for="SelectedAirport" class="text-danger"></span>
                </div>
            </section>
            <!-- Budget Type -->
            <section id="budget" class="form-section">
                <h2 class="section-title">Tell us your travel Budget?</h2>
                <div class="form-group block-options">
                    <div class="block-option">
                        <input type="radio" asp-for="BudgetType" value="Low" id="budget-Low" />
                        <label for="budget-Low">
                            <img src="~/images/money.png" alt="Low budget icon">
                            Low
                        </label>
                    </div>
                    <div class="block-option">
                        <input type="radio" asp-for="BudgetType" value="Medium" id="budget-Medium" />
                        <label for="budget-Medium">
                            <img src="~/images/money.png" alt="Medium budget icon">
                            Medium
                        </label>
                    </div>
                    <div class="block-option">
                        <input type="radio" asp-for="BudgetType" value="High" id="budget-High" />
                        <label for="budget-High">
                            <img src="~/images/money.png" alt="High budget icon">
                            High
                        </label>
                    </div>
                    <span asp-validation-for="BudgetType" class="text-danger"></span>
                </div>
            </section>
            <!-- Hotel Star Rating -->
            <section id="activities" class="form-section">
                <h2 class="section-title">Select Hotel Rating</h2>
                <div class="form-group block-options">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <div class="block-option">
                            <input type="radio" asp-for="HotelStarRating" value="@i" id="rating-@i" />
                            <label for="rating-@i">
                                <img src="~/images/star.png" alt="@i star icon">
                                @i Star
                            </label>
                        </div>
                    }
                    <span asp-validation-for="HotelStarRating" class="text-danger"></span>
                </div>
            </section>
            <!-- Submit Button -->
            <div class="submit-container">
                <button type="submit" class="generate-plan-btn">
                    Generate My Plan
                </button>
            </div>
        </form>
    </div>
</main>
<footer class="site-footer">
    <div class="container footer-container">
        <a href="#" class="footer-logo">
            <img src="~/images/ViaItalia logo in white.png" alt="ViaItalia white logo">
        </a>
        <nav class="footer-nav">
            <ul>
                    <li><a asp-controller="Pages" asp-action="Contactus">Contact us</a></li>
                    <li><a asp-controller="Pages" asp-action="Aboutus">About us</a></li>
                    <li><a asp-controller="Pages" asp-action="Terms">Terms & Conditions</a></li>
                    <li><a asp-controller="Pages" asp-action="PrivacyPolicy">Privacy Policy</a></li>
                    <li><a asp-controller="Pages" asp-action="Blog">Blog</a></li>
            </ul>
        </nav>
    </div>
</footer>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/recommendation form.js"></script>
   
}
</body>
</html>