@model ViaitaliaAPI.Models.TravelPlannerRequest
@{
    ViewData["Title"] = "Plan Your Trip";
    Layout = null;
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var requestToken = tokens.RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plan Your Trip - Viaitalia</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
    <style>
        .planner-form { max-width: 720px; margin: 0 auto; }
        .form-section { margin-bottom: var(--space-xl); }
        .block-options { display: flex; gap: var(--space-md); flex-wrap: wrap; }
        .block-option { position: relative; }
        .block-option input { position: absolute; opacity: 0; }
        .block-option label {
            display: flex; flex-direction: column; align-items: center; gap: var(--space-xs);
            padding: var(--space-md); border: 1.5px solid var(--color-border); border-radius: var(--radius-md);
            cursor: pointer; font-size: var(--fs-sm); min-width: 90px; text-align: center;
        }
        .block-option input:checked + label { border-color: var(--color-primary); background: rgba(13,115,119,0.06); color: var(--color-primary); }
        .block-option img { width: 28px; height: 28px; }
        .radio-large { display: flex; gap: var(--space-lg); }
        .theme-select { min-height: 180px; }
        .duration-controls { display: flex; align-items: center; gap: var(--space-sm); }
        .duration-controls button {
            width: 36px; height: 36px; border-radius: 50%; border: 1.5px solid var(--color-border);
            background: white; cursor: pointer; font-size: var(--fs-lg);
        }
        .duration-controls input { width: 70px; text-align: center; padding: 8px; border: 1.5px solid var(--color-border); border-radius: var(--radius-sm); }
    </style>
</head>
<body>

@await Html.PartialAsync("_Header")

<div class="section-wrap" style="padding-top: var(--space-xl);">
    <div class="planner-form">
        <span class="section-eyebrow">Travel Planner</span>
        <h1>Tell us about your trip</h1>
        <p style="margin-bottom: var(--space-xl);">A few details, and we'll match you with cities, hotels, and places that fit.</p>

        <form asp-action="Plan" method="post">
            @Html.AntiForgeryToken()

            <section class="form-section">
                <h3>Who's traveling?</h3>
                <div class="form-group block-options">
                    <div class="block-option">
                        <input type="radio" asp-for="GroupType" value="Friends" id="group-Friends" />
                        <label for="group-Friends"><img src="~/images/followers.png" alt="Friends" />Friends</label>
                    </div>
                    <div class="block-option">
                        <input type="radio" asp-for="GroupType" value="Couple" id="group-Couple" />
                        <label for="group-Couple"><img src="~/images/couple.png" alt="Couple" />Couple</label>
                    </div>
                    <div class="block-option">
                        <input type="radio" asp-for="GroupType" value="Family" id="group-Family" />
                        <label for="group-Family"><img src="~/images/family.png" alt="Family" />Family</label>
                    </div>
                </div>
                <span asp-validation-for="GroupType" class="alert alert-error" style="display:none;"></span>
            </section>

            <section class="form-section">
                <h3>How many days?</h3>
                <div class="duration-controls">
                    <button type="button" id="decreaseBtn">−</button>
                    <input asp-for="TripDuration" id="durationInput" type="number" min="1" value="5" class="form-input" />
                    <button type="button" id="increaseBtn">+</button>
                </div>
            </section>

            <section class="form-section">
                <h3>Do you require wheelchair access?</h3>
                <div class="form-group radio-large">
                    <label><input type="radio" asp-for="RequiresWheelchair" value="true" /> Yes</label>
                    <label><input type="radio" asp-for="RequiresWheelchair" value="false" /> No</label>
                </div>
            </section>

            <section class="form-section">
                <h3>What themes interest you?</h3>
                <select asp-for="SelectedTags" asp-items="@(new MultiSelectList(Model.AvailableTags))" multiple class="form-select theme-select"></select>
            </section>

            <section class="form-section">
                <h3>Arrival airport</h3>
                <select asp-for="SelectedAirport" class="form-select">
                    <option value="">-- Select Airport --</option>
                    @foreach (var airport in Model.AvailableAirports)
                    {
                        <option value="@airport">@airport</option>
                    }
                </select>
            </section>

            <section class="form-section">
                <h3>Travel budget</h3>
                <div class="form-group block-options">
                    <div class="block-option">
                        <input type="radio" asp-for="BudgetType" value="Low" id="budget-Low" />
                        <label for="budget-Low"><img src="~/images/money.png" alt="Low" />Low</label>
                    </div>
                    <div class="block-option">
                        <input type="radio" asp-for="BudgetType" value="Medium" id="budget-Medium" />
                        <label for="budget-Medium"><img src="~/images/money.png" alt="Medium" />Medium</label>
                    </div>
                    <div class="block-option">
                        <input type="radio" asp-for="BudgetType" value="High" id="budget-High" />
                        <label for="budget-High"><img src="~/images/money.png" alt="High" />High</label>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <h3>Preferred hotel rating</h3>
                <div class="form-group block-options">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <div class="block-option">
                            <input type="radio" asp-for="HotelStarRating" value="@i" id="rating-@i" />
                            <label for="rating-@i"><img src="~/images/star.png" alt="@i star" />@i Star</label>
                        </div>
                    }
                </div>
            </section>

            <button type="submit" class="btn btn-primary" style="width:100%; text-align:center; font-size:var(--fs-lg); padding:14px;">
                Generate My Plan
            </button>
        </form>
    </div>
</div>

@await Html.PartialAsync("_Footer")

<script>
document.getElementById('increaseBtn')?.addEventListener('click', function () {
    var input = document.getElementById('durationInput');
    input.value = parseInt(input.value || 1, 10) + 1;
});
document.getElementById('decreaseBtn')?.addEventListener('click', function () {
    var input = document.getElementById('durationInput');
    input.value = Math.max(1, parseInt(input.value || 1, 10) - 1);
});
</script>

</body>
</html>