@model ViaitaliaAPI.Models.TravelPlannerResponse
@{
    ViewData["Title"] = "Your Travel Plan";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <title>Your Travel Plan - Viaitalia</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
</head>
<body>

@await Html.PartialAsync("_Header")

<div class="section-wrap" style="padding-top: var(--space-xl);">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:var(--space-md);">
        <div>
            <span class="section-eyebrow">Your plan</span>
            <h1 style="margin-bottom:0;">Travel Plan Result</h1>
        </div>
        <a asp-controller="TravelPlanner" asp-action="Plan" class="btn btn-outline">Modify plan</a>
    </div>

    <div class="fact-grid" style="margin-top: var(--space-lg);">
        <div class="fact-item"><div class="fact-item__label">Group Type</div><div class="fact-item__value">@Model.Request.GroupType</div></div>
        <div class="fact-item"><div class="fact-item__label">Trip Duration</div><div class="fact-item__value">@Model.Request.TripDuration days</div></div>
        <div class="fact-item"><div class="fact-item__label">Wheelchair</div><div class="fact-item__value">@(Model.Request.RequiresWheelchair ? "Yes" : "No")</div></div>
        <div class="fact-item"><div class="fact-item__label">Budget</div><div class="fact-item__value">@Model.Request.BudgetType</div></div>
        <div class="fact-item"><div class="fact-item__label">Hotel Stars</div><div class="fact-item__value">@Model.Request.HotelStarRating★</div></div>
        <div class="fact-item"><div class="fact-item__label">Arrival Airport</div><div class="fact-item__value">@Model.Request.SelectedAirport</div></div>
        <div class="fact-item"><div class="fact-item__label">Themes</div><div class="fact-item__value">@string.Join(", ", Model.Request.SelectedTags)</div></div>
    </div>

    <h2 style="margin-top: var(--space-2xl);">Italy Trip Map</h2>
    <div id="italy-map" style="height:450px; width:100%; border-radius:var(--radius-lg); overflow:hidden; border:1px solid var(--color-border);"></div>

    <h2 style="margin-top: var(--space-2xl);">Weather Summary</h2>
    <div id="weather-container" class="fact-grid"></div>

    @foreach (var city in Model.Cities)
    {
        <div style="margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border);">
            <div class="detail-hero" style="margin-bottom: var(--space-md);">
                @if (city.Image != null)
                {
                    <img src="@city.Image.FilePath" alt="@city.CityName"
                         onerror="this.onerror=null;this.src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';this.style.background='var(--color-border)';" />
                }
                <div class="detail-hero__overlay">
                    <h2 class="detail-hero__title">@city.CityName</h2>
                </div>
            </div>
            <p style="font-size: var(--fs-sm);">Nearest Airport: <strong>@city.NearestAirportName</strong></p>

            <h3>Hotels</h3>
            <div class="discovery-grid">
                @{
                    var cityHotels = Model.Hotels.Where(h => h.CityId == city.CityId).ToList();
                }
                @if (cityHotels.Any())
                {
                    @foreach (var hotel in cityHotels)
                    {
                        <div class="card"><div class="card__body">
                            <p class="card__title" style="margin-bottom:2px;">@hotel.HotelName</p>
                            <p class="card__meta">Budget: @hotel.Budget · @(hotel.Stars ?? 0)★</p>
                        </div></div>
                    }
                }
                else
                {
                    <p class="card__meta">No hotels match your filters.</p>
                }
            </div>

            <h3 style="margin-top: var(--space-lg);">Restaurants</h3>
            <div class="discovery-grid">
                @{
                    var cityRestaurants = Model.Restaurants.Where(r => r.CityId == city.CityId).ToList();
                }
                @if (cityRestaurants.Any())
                {
                    @foreach (var restaurant in cityRestaurants)
                    {
                        <div class="card"><div class="card__body"><p class="card__title">@restaurant.RestaurantName</p></div></div>
                    }
                }
                else
                {
                    <p class="card__meta">No restaurants available.</p>
                }
            </div>

            <h3 style="margin-top: var(--space-lg);">Shopping Malls</h3>
            <div class="discovery-grid">
                @{
                    var cityMalls = Model.ShoppingMalls.Where(s => s.CityId == city.CityId).ToList();
                }
                @if (cityMalls.Any())
                {
                    @foreach (var mall in cityMalls)
                    {
                        <div class="card"><div class="card__body"><p class="card__title">@mall.MallName</p></div></div>
                    }
                }
                else
                {
                    <p class="card__meta">No shopping malls found.</p>
                }
            </div>

            <h3 style="margin-top: var(--space-lg);">Attraction Places</h3>
            <div class="discovery-grid">
                @{
                    var cityAttractions = Model.Attractions.Where(a => a.CityId == city.CityId).ToList();
                }
                @if (cityAttractions.Any())
                {
                    @foreach (var attraction in cityAttractions)
                    {
                        <div class="card"><div class="card__body"><p class="card__title">@attraction.AttractionName</p></div></div>
                    }
                }
                else
                {
                    <p class="card__meta">No accessible attractions found.</p>
                }
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_Footer")

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script id="weather-data" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CityWeatherData))
</script>
<script id="coords-data" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CityCoordinates))
</script>
<script id="italy-data" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new { lat = ViewBag.ItalyLat, lng = ViewBag.ItalyLng }))
</script>
<script src="~/js/planresult.js"></script>

</body>
</html>