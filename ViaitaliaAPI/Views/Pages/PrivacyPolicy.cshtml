@{
    ViewData["Title"] = "Privacy Policy";
    Layout = null; // common layout
}

<!-- Page-specific CSS -->
<link rel="stylesheet" href="~/css/privacypolicy.css?v=1" />

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Laila&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Ledger&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Lalezar&display=swap" rel="stylesheet">

<!-- Navigation -->
 <div data-layer="Frame 78" class="Frame78">
    <div data-layer="Home" class="Home"><a asp-controller="Home" asp-action="Index">Home</a></div>
    <div data-layer="Blog" class="Blog"><a asp-controller="Pages" asp-action="Blog">Blog</a></div>
    <div data-layer="About us" class="AboutUs"><a asp-controller="Pages" asp-action="Aboutus">About us</a></div>
    <div data-layer="Contact us" class="ContactUs"><a asp-controller="Pages" asp-action="Contactus">Contact us</a></div>
    <div data-layer="Privacy Policy" class="PrivacyPolicy"><a asp-controller="Pages" asp-action="PrivacyPolicy">Privacy Policy</a></div>

    <div data-layer="Rectangle 47" class="Rectangle47"></div>
    <div data-layer="Sign in" class="SignIn"><a asp-controller="Auth" asp-action="Login">Sign in</a></div>
    <div data-layer="Line 13" class="Line13"></div>
    <img data-layer="ViaItalia teal + blue combo logo 1"
         class="ViaitaliaTealBlueComboLogo1"
         src="~/images/ViaItalia teal + blue combo logo.png" alt="ViaItalia Logo" />

    <!-- Active indicator -->
    <div data-layer="Rectangle 59" class="Rectangle59"></div>
</div>


<!-- Header -->
<div class="Frame104">
    <div class="PrivacyPolicy1">Privacy Policy</div>
    <div class="Line15"></div>
    <div class="description-1">
        At ViaItalia, your privacy matters to us. Whether you're planning your dream trip or exploring Italian cities through our blog, we want you to feel safe and informed about how your data is collected and used.
    </div>
</div>

<!-- Info -->
<div class="info">
    <div class="inforectangle"></div>
    <div class="infotext">What Information We Collect</div>
    <div class="text-1">
        When you interact with our site, we may collect the following:
        <ul>
            <li>Personal Information: Like your name, email address, or preferences — only if you provide them through forms.</li>
            <li>Travel Preferences: Including selected themes, companions, trip duration, airport, and budget.</li>
            <li>Technical Data: Like your device type, browser, IP address, and activity — collected via cookies and analytics tools.</li>
        </ul>
    </div>
    <div data-svg-wrapper data-layer="Analyze" class="Analyze">
        <img src="~/images/form.png" alt="Analyze Icon" />
    </div>
</div>

<!-- Data -->
<div class="data">
    <div class="datarectangle"></div>
    <div class="datatext">Why We Collect Your Data</div>
    <div class="text-2">
        We use your information to:
        <ul>
            <li>Personalize your travel experience and suggestions</li>
            <li>Generate trip results tailored to your preferences</li>
            <li>Improve the performance and usability of our platform</li>
            <li>Communicate with you if you contact us</li>
            <li>We do not sell or share your personal data with advertisers or unknown third parties.</li>
        </ul>
    </div>
    <div data-svg-wrapper data-layer="Database" class="Database">
        <img src="~/images/back-up.png" alt="Database Icon" />
    </div>
</div>

<!-- Cookies -->
<div class="cookies">
    <div class="cookiesrectangle"></div>
    <div class="cookiestext">Use of Cookies</div>
    <div class="text-3">
        We use cookies to:
        <ul>
            <li>Understand how visitors use our platform</li>
            <li>Enhance site performance and speed</li>
            <li>Save your form preferences temporarily for better user experience</li>
            <li>You can control cookie settings through your browser.</li>
        </ul>
    </div>
    <div data-svg-wrapper data-layer="Cookie" class="Cookie">
        <img src="~/images/cookie.png" alt="Cookie Icon" />
    </div>
</div>

<!-- Third Party -->
<div class="thirdparty">
    <div class="thirdpartyrectangle"></div>
    <div class="ThirdPartytext">Third-Party Tools</div>
    <div class="text-4">
        We may use trusted services like:
        <ul>
            <li>Google Analytics (to track traffic anonymously)</li>
            <li>Embedded maps or widgets (to show cities, restaurants, or attractions)</li>
            <li>These tools may collect minimal data under their own policies.</li>
        </ul>
    </div>
    <div data-svg-wrapper data-layer="Handshake" class="Handshake">
        <img src="~/images/handshake.png" alt="Handshake Icon" />
    </div>
</div>

<!-- Protect -->
<div class="protect">
    <div class="protectrectangle"></div>
    <div class="protect1">
        <div class="protecttext">How We Protect Your Information</div>
        <div class="text-5">
            <ul>
                <li>We use standard security measures to keep your data safe.</li>
                <li>While no system is 100% secure, we take your privacy seriously and regularly review our security practices.</li>
            </ul>
        </div>
        <div data-svg-wrapper data-layer="Lock" class="Lock">
            <img src="~/images/lock.png" alt="Lock Icon" />
        </div>
    </div>
</div>

<!-- Rights -->
<div class="right">
    <div class="rightrectangle"></div>
    <div class="righttext">Your Choices & Rights</div>
    <div class="text-6">
        You have the right to:
        <ul>
            <li>Know what personal data we hold</li>
            <li>Request that we correct or delete your data</li>
            <li>Contact us with any questions about your privacy</li>
            <li>📧 Reach us anytime at: <a href="https://mail.google.com/mail/?view=cm&fs=1&to=viaitalia001@gmail.com" target="_blank">
            viaitalia001@gmail.com
        </a></li>
        </ul>
    </div>
    <div data-svg-wrapper data-layer="Done" class="Done">
        <img src="~/images/check.png" alt="Done Icon" />
    </div>
</div>

<!-- Footer Note -->
<div class="fav">
    <div class="favrectangle"></div>
    <div class="favtext">
        ViaItalia is built with love for travel and respect for users. We're committed to keeping your journey smooth, safe, and private.
    </div>
    <div class="text-7">
        ViaItalia – Plan Smart. Travel Beautifully.
    </div>
    <div data-svg-wrapper data-layer="Favorite" class="Favorite">
        <img src="~/images/heart.png" alt="Favorite Icon" />
    </div>
</div>

<!-- Footer -->
<div class="footer">
        <div class="footerrectangle"></div>
        <img class="ViaitaliaLogoInWhite1" src="~/images/ViaItalia logo in white.png" alt="Logo">
        <div class="footer-nav">
            <div class="ContactUs-1"><a asp-controller="Pages" asp-action="Contactus">Contact Us</a></div>
            <div class="AboutUs-1"><a asp-controller="Pages" asp-action="Aboutus">About Us</a></div>
            <div class="TermCondition-1"><a asp-controller="Pages" asp-action="Terms">Terms & Conditions</a></div>
            <div class="PrivacyPolicy-1"><a asp-controller="Pages" asp-action="PrivacyPolicy">Privacy Policy</a></div>
            <div class="Blog-1"><a asp-controller="Pages" asp-action="Blog">Blog</a></div>
        </div>
    </div>


<!-- Page-specific JS -->
<script src="~/js/privacypolicy.js"></script>
