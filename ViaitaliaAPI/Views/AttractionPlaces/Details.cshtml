@model ViaitaliaAPI.Models.AttractionPlace
@{
    ViewData["Title"] = Model.AttractionName;
    Layout = null;
    bool isWriter = User.IsInRole("Writer");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.AttractionName - Viaitalia</title>
    <link rel="stylesheet" href="~/css/design-system.css" />
</head>
<body>

@await Html.PartialAsync("_Header")

<div class="detail-wrap">
    <p class="detail-breadcrumb"><a asp-controller="AttractionPlaces" asp-action="Index">Attractions</a> / @Model.AttractionName</p>

    <div class="detail-hero">
        @if (Model.Image != null)
        {
            <img src="@Model.Image.FilePath" alt="@Model.AttractionName"
                 onerror="this.onerror=null;this.src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';this.style.background='var(--color-border)';" />
        }
        <div class="detail-hero__overlay">
            <div>
                <h1 class="detail-hero__title">@Model.AttractionName</h1>
                <p class="detail-hero__subtitle">@Model.CityName</p>
            </div>
        </div>
    </div>

    <div class="fact-grid">
        <div class="fact-item"><div class="fact-item__label">Type</div><div class="fact-item__value">@(Model.Type ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Entry Fee</div><div class="fact-item__value">@(Model.EntryFee ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Opening Hours</div><div class="fact-item__value">@(Model.OpeningHours ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">Avg. Duration</div><div class="fact-item__value">@(Model.AverageDuration?.ToString() ?? "N/A")</div></div>
        <div class="fact-item"><div class="fact-item__label">UNESCO Site</div><div class="fact-item__value">@((Model.IsUnesco != null && Model.IsUnesco.Equals("true", StringComparison.OrdinalIgnoreCase)) ? "Yes" : "No")</div></div>
        <div class="fact-item"><div class="fact-item__label">Wheelchair Access</div><div class="fact-item__value">@(Model.WheelchairAccessible ?? "N/A")</div></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <h3>About</h3>
        <p>@Model.Description</p>
    }

    @if (isWriter)
    {
        <div class="writer-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline btn-sm">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">Delete</a>
        </div>
    }
</div>

@await Html.PartialAsync("_Footer")

</body>
</html>