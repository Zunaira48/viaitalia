@model ViaitaliaAPI.Models.AttractionPlace

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Attraction</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="AttractionName" class="control-label"></label>
                <input asp-for="AttractionName" class="form-control" />
                <span asp-validation-for="AttractionName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Type" class="control-label"></label>
                <input asp-for="Type" class="form-control" />
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Latitude" class="control-label"></label>
                <input asp-for="Latitude" class="form-control" />
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Longitude" class="control-label"></label>
                <input asp-for="Longitude" class="form-control" />
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EntryFee" class="control-label"></label>
                <input asp-for="EntryFee" class="form-control" />
                <span asp-validation-for="EntryFee" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="OpeningHours" class="control-label"></label>
                <input asp-for="OpeningHours" class="form-control" />
                <span asp-validation-for="OpeningHours" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AverageDuration" class="control-label"></label>
                <input asp-for="AverageDuration" class="form-control" />
                <span asp-validation-for="AverageDuration" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PopularityRank" class="control-label"></label>
                <input asp-for="PopularityRank" class="form-control" />
                <span asp-validation-for="PopularityRank" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="IsUnesco" class="form-check-input" />
                <label asp-for="IsUnesco" class="form-check-label"></label>
                <span asp-validation-for="IsUnesco" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="OfficialWebsite" class="control-label"></label>
                <input asp-for="OfficialWebsite" class="form-control" />
                <span asp-validation-for="OfficialWebsite" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Tags" class="control-label"></label>
                <input asp-for="Tags" class="form-control" />
                <span asp-validation-for="Tags" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NearbyTransport" class="control-label"></label>
                <input asp-for="NearbyTransport" class="form-control" />
                <span asp-validation-for="NearbyTransport" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="WheelchairAccessible" class="form-check-input" />
                <label asp-for="WheelchairAccessible" class="form-check-label"></label>
                <span asp-validation-for="WheelchairAccessible" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CityId" class="control-label"></label>
                <select asp-for="CityId" class="form-control" asp-items="ViewBag.CityId"></select>
                <span asp-validation-for="CityId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="imageFile">Image</label>
                <input type="file" name="imageFile" class="form-control" />
            </div>

            @if (Model.ImageId != null && Model.Image != null && !string.IsNullOrEmpty(Model.Image.FilePath))
            {
                <div class="mt-3">
                    <label>Current Image</label>
                    <img src="@Model.Image.FilePath" alt="Attraction Image" class="img-thumbnail" width="250" />
                </div>
            }



            <div class="form-group mt-3">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}







