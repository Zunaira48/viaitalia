@model ViaitaliaAPI.Models.AttractionPlace

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this attraction?</h3>
<div>
    <h4>Attraction Place Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CityName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CityName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AttractionId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AttractionId)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AttractionName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AttractionName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Type)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Type)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Latitude)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Latitude)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Longitude)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Longitude)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EntryFee)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EntryFee)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OpeningHours)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OpeningHours)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AverageDuration)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AverageDuration)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PopularityRank)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PopularityRank)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsUnesco)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsUnesco)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OfficialWebsite)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OfficialWebsite)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Tags)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Tags)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NearbyTransport)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NearbyTransport)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.WheelchairAccessible)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WheelchairAccessible)
        </dd>
        @if (Model.ImageId != null && Model.Image != null && !string.IsNullOrEmpty(Model.Image.FilePath))
        {
            <div class="mt-3">
                <label>Current Image</label>
                <img src="@Model.Image.FilePath" alt="Attraction Image" class="img-thumbnail" width="250" />
            </div>
        }
        else
        {
            <dt class="col-sm-2">Image</dt>
            <dd class="col-sm-10">Not Assigned</dd>
        }
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
